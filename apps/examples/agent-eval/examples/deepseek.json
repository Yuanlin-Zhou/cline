{
  "version": 1,
  "defaults": {
    "providerId": "openai-compatible",
    "modelId": "deepseek-v4-flash",
    "baseUrl": "https://api.deepseek.com",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "tools": "none",
    "maxIterations": 6,
    "timeoutMs": 180000
  },
  "cases": [
    {
      "id": "deepseek-history-test",
      "history": [
        { "role": "user", "content": "\u9879\u76ee\u4f7f\u7528 Bun \u4f5c\u4e3a\u5305\u7ba1\u7406\u5668\uff0c\u540e\u7eed\u8bf7\u4f7f\u7528\u4e2d\u6587\u56de\u7b54\u3002" },
        { "role": "assistant", "content": "\u597d\u7684\uff0c\u6211\u4f1a\u4f7f\u7528 Bun\uff0c\u5e76\u7528\u4e2d\u6587\u56de\u7b54\u3002" }
      ],
      "prompt": "\u8bf7\u544a\u8bc9\u6211\u5b89\u88c5\u9879\u76ee\u4f9d\u8d56\u5e94\u8be5\u6267\u884c\u4ec0\u4e48\u547d\u4ee4\u3002",
      "assertions": { "contains": ["bun install"], "finishReason": "completed" }
    },
    {
      "id": "deepseek-chinese-summary",
      "history": [
        { "role": "user", "content": "\u8bf7\u59cb\u7ec8\u4f7f\u7528\u7b80\u6d01\u7684\u4e2d\u6587\u56de\u7b54\u3002" },
        { "role": "assistant", "content": "\u597d\u7684\uff0c\u6211\u4f1a\u4f7f\u7528\u7b80\u6d01\u7684\u4e2d\u6587\u56de\u7b54\u3002" }
      ],
      "prompt": "\u8bf7\u7528\u4e00\u53e5\u4e2d\u6587\u89e3\u91ca\u4ec0\u4e48\u662f API\u3002",
      "assertions": { "matches": ["API"], "finishReason": "completed" }
    },
    {
      "id": "deepseek-bun-command",
      "prompt": "\u5728\u4e00\u4e2a\u4f7f\u7528 Bun \u7684 JavaScript \u9879\u76ee\u4e2d\uff0c\u5982\u4f55\u8fd0\u884c package.json \u4e2d\u540d\u4e3a test \u7684\u811a\u672c\uff1f\u53ea\u7ed9\u51fa\u547d\u4ee4\u5e76\u7b80\u77ed\u8bf4\u660e\u3002",
      "assertions": { "contains": ["bun run test"], "notContains": ["npm test"], "finishReason": "completed" }
    },
    {
      "id": "deepseek-json-reasoning",
      "prompt": "\u4e0b\u9762\u6709\u4e09\u4e2a\u6570\u5b57\uff1a12\u30017\u30015\u3002\u8bf7\u8ba1\u7b97\u5b83\u4eec\u7684\u603b\u548c\uff0c\u5e76\u7528\u4e2d\u6587\u7ed9\u51fa\u7b97\u5f0f\u548c\u7ed3\u679c\u3002",
      "assertions": { "contains": ["24"], "matches": ["12\\s*[+]\\s*7\\s*[+]\\s*5"], "finishReason": "completed" }
    },
    {
      "id": "deepseek-structured-answer",
      "history": [
        { "role": "user", "content": "\u56de\u7b54\u65f6\u8bf7\u4f7f\u7528 Markdown\u3002" },
        { "role": "assistant", "content": "\u597d\u7684\uff0c\u6211\u4f1a\u4f7f\u7528 Markdown \u683c\u5f0f\u56de\u7b54\u3002" }
      ],
      "prompt": "\u8bf7\u5217\u51fa\u5f00\u59cb\u4e00\u4e2a\u8f6f\u4ef6\u9879\u76ee\u65f6\u6700\u91cd\u8981\u7684\u4e09\u4e2a\u6b65\u9aa4\uff0c\u4f7f\u7528 Markdown \u65e0\u5e8f\u5217\u8868\u3002",
      "assertions": { "contains": ["-"], "finishReason": "completed" }
    }
  ]
}
