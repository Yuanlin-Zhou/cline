{
	"name": "@cline/example-agent-eval",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.13",
	"scripts": {
		"web": "bun run src/web/server.ts",
		"test:web": "bun test src/web",
		"smoke:web": "bun run scripts/smoke-web.ts",
		"dev": "bun run src/index.ts",
		"eval": "bun run src/index.ts",
		"build:sdk": "bun run --cwd ../../.. build:sdk",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"package": "bun run build && bun run scripts/package.ts",
		"test": "bun test",
		"smoke:release": "bun scripts/smoke-release.ts",
		"start": "node dist/index.js",
		"mongo:prepare": "bun run scripts/mongo-prepare.ts",
		"mongo:migrate": "bun run scripts/mongo-migrate.ts",
		"test:mongo": "bun test src/web/mongo.integration.test.ts"
	},
	"dependencies": {
		"@cline/sdk": "workspace:*",
		"mongodb": "6.21.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": "1.3.13",
		"node": ">=22"
	}
}
