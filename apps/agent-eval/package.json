{
	"name": "@cline/agent-eval",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.13",
	"scripts": {
		"web": "bun scripts/web.ts",
		"test:web": "bun test src",
		"smoke:web": "bun run scripts/smoke-web.ts",
		"dev": "bun run src/cli/index.ts",
		"eval": "bun run src/cli/index.ts",
		"build:sdk": "bun run --cwd ../.. build:sdk",
		"build": "tsc && tsc --noEmit -p web/tsconfig.json && bun run build:web",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
		"package": "bun run build && bun run scripts/package.ts",
		"test": "bun test",
		"smoke:release": "bun scripts/smoke-release.ts",
		"start": "node dist/cli/index.js",
		"mongo:prepare": "bun run scripts/mongo-prepare.ts",
		"mongo:migrate": "bun run scripts/mongo-migrate.ts",
		"test:mongo": "bun test src/modules/runs/mongo.integration.test.ts",
		"start:web": "bun src/api/server.ts",
		"build:web": "vite build --config web/vite.config.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"test:browser": "playwright test --config web/playwright.config.ts"
	},
	"dependencies": {
		"@cline/sdk": "workspace:*",
		"mongodb": "6.21.0",
		"@cline/llms": "workspace:*",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.9.0",
		"@tanstack/react-query": "^5.90.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-tabs": "^1.1.13"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@types/bun": "^1.3.13",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.11"
	},
	"engines": {
		"bun": "1.3.13",
		"node": ">=22"
	}
}
