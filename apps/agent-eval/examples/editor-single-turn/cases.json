        ]
      }
    },
    {
      "id": "editor-history-two-files",
      "description": "历史提供两个文件，本轮要求同一响应按指定顺序局部替换",
      "replayMode": "function-call",
      "functionCall": {
        "tools": [
          "editor"
        ],
        "toolChoice": "auto"
      },
      "systemPrompt": "你正在进行工具调用参数评测。只根据历史消息和本轮问题生成原生 editor 调用；本模式不执行工具。不要把调用写成普通文字或 JSON 代码块。历史中已提供所需文件内容和行数，不需要读取文件。",
      "tags": [
        "editor",
        "历史上下文",
        "参数正确性"
      ],
      "history": [
        {
          "role": "user",
          "content": "有两个已存在的文件，内容如下，每行以 LF 结束，包括末行。\n/project/a.env：\n```text\nNAME=alpha\nENABLED=false\n```\n/project/b.env：\n```text\nNAME=beta\nENABLED=false\n```"
        },
        {
          "role": "assistant",
          "content": "知道了两个文件及其原内容。"
        },
        {
          "role": "user",
          "content": "要求两个文件各自只替换 ENABLED=false 加 LF 为 ENABLED=true 加 LF；NAME 行保持不变。"
        },
        {
          "role": "assistant",
          "content": "明白，只替换开关行。"
        }
      ],
      "prompt": "请在本轮同一个模型响应中返回两个 editor 调用：第一个修改 a.env，第二个修改 b.env。每个文件只调用一次，使用 old_text 局部替换，不要使用 insert_line 或重写整份文件。",
      "grading": {
        "version": 1,
        "rules": [
          {
            "id": "editor-expected",
            "kind": "script",
            "verifierId": "example-editor-scenarios",
            "required_inputs": [
              "execution",
              "diagnostics"
            ],
            "params": {
              "expected_count": 2,
              "expected_total_calls": 2,
              "allowed_tools": [
                "editor"
              ],
              "expected_calls": [
                {
                  "path": "/project/a.env",
                  "new_text": "ENABLED=true\n",
                  "old_text": "ENABLED=false\n",
                  "insert_line": null
                },
                {
                  "path": "/project/b.env",
                  "new_text": "ENABLED=true\n",
                  "old_text": "ENABLED=false\n",
                  "insert_line": null
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
