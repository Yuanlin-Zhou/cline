{
  "version": 1,
  "cases": [
    {
      "id": "fc-two-calls",
      "description": "在一个模型响应中生成两个不同工具调用；不执行",
      "replayMode": "function-call",
      "functionCall": {
        "tools": [
          "read_files",
          "search_codebase"
        ],
        "toolChoice": "auto"
      },
      "history": [],
      "prompt": "在这一次响应中并列调用两个工具：用 read_files 读取 /project/README.md；用 search_codebase 搜索 TODO。每个工具只调用一次，不要执行后再回复。",
      "grading": {
        "version": 1,
        "rules": [
          {
            "id": "read_files",
            "kind": "script",
            "verifierId": "example-fc-read_files",
            "required_inputs": [
              "execution",
              "diagnostics"
            ],
            "params": {
              "expected_count": 1,
              "expected_total_calls": 2,
              "allowed_tools": [
                "read_files",
                "search_codebase"
              ]
            }
          },
          {
            "id": "search_codebase",
            "kind": "script",
            "verifierId": "example-fc-search_codebase",
            "required_inputs": [
              "execution",
              "diagnostics"
            ],
            "params": {
              "expected_count": 1,
              "expected_total_calls": 2,
              "allowed_tools": [
                "read_files",
                "search_codebase"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fc-history-editor",
      "description": "历史上下文确定内容，当前一次响应生成 editor 调用",
      "replayMode": "function-call",
      "functionCall": {
        "tools": [
          "editor"
        ],
        "toolChoice": "auto"
      },
      "history": [
        {
          "role": "user",
          "content": "我们约定文件内容必须为 hello world，并以换行结尾。"
        },
        {
          "role": "assistant",
          "content": "明白。"
        }
      ],
      "prompt": "请按照之前约定，用 editor 创建 /project/hello.txt；只发出一次原生工具调用。",
      "grading": {
        "version": 1,
        "rules": [
          {
            "id": "format",
            "kind": "script",
            "verifierId": "example-fc-editor",
            "required_inputs": [
              "execution",
              "diagnostics"
            ],
            "params": {
              "expected_count": 1,
              "expected_total_calls": 1,
              "allowed_tools": [
                "editor"
              ]
            }
          }
        ]
      }
    }
  ]
}
